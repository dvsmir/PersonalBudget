# Copy to .env and adjust. All settings use the BUDGET_ prefix (see app/config.py).
BUDGET_DATABASE_URL=sqlite:///./data/budget.db
BUDGET_SECRET_KEY=change-me-to-a-long-random-string
BUDGET_COOKIE_SECURE=false
BUDGET_CORS_ORIGINS=["http://localhost:5173"]
# Needed for AI categorisation of imports
BUDGET_ANTHROPIC_API_KEY=
BUDGET_SCHEDULER_ENABLED=true
